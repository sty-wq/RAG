# 作为 shell 环境变量加载；代码不会自动读取此文件，也不会改动 .env.ocr。
RAG_RETRIEVAL_MODE=hybrid
RAG_CANDIDATE_K=50
RAG_RRF_K=60
# 使用项目专用变量；MILVUS_URI 是 PyMilvus 的服务器地址变量。
# RAG_MILVUS_URI=/absolute/path/to/milvus.db

# none / local / http / deepseek；local 首次显式使用时会下载模型。
RERANK_BACKEND=local
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_BATCH_SIZE=16
RERANK_MAX_LENGTH=512
RERANK_TIMEOUT=120
# RERANK_REVISION=<Hugging Face commit hash>
# RERANK_DEVICE=cpu
# RERANK_CACHE_DIR=/absolute/path/to/model-cache
# RAG_MIN_RERANK_SCORE=0.5  # 只有用所选模型的评测数据校准后再设置

# HTTP 模式时另行配置，BASE_URL 后会追加 /rerank。
# RERANK_BASE_URL=http://127.0.0.1:7997/v1
# RERANK_API_KEY=

# DeepSeek LLM listwise 重排：显式设置 RERANK_BACKEND=deepseek 或 --rerank deepseek。
# 自动读取项目 .env.ocr 的 DEEPSEEK_BASE_URL / DEEPSEEK_MODEL / DEEPSEEK_API_KEY。
# 不使用 RERANK_MODEL / RERANK_REVISION；不会改写 OCR 配置。
# RERANK_DEEPSEEK_ENV=/absolute/path/to/.env.ocr
# 一次调用排序全部候选，最多 100 条 / 160000 输入字符，超出直接报错而不截断。
# 云端请求计费；结果是名次，不是相关性概率，不支持 RAG_MIN_RERANK_SCORE。

# QuickRouter 云端 Qwen3：使用 --rerank http，模型名不是本地 Hugging Face 仓库。
# RERANK_BASE_URL=https://api.quickrouter.ai/v1
# RERANK_MODEL=qwen3-rerank
# 在已配置 embedding 的终端显式复用 key：export RERANK_API_KEY="$EMBED_API_KEY"
# 不自动跨服务复用密钥。EMBED_MODEL 保持原索引的 text-embedding-3-small。
# qwen3-rerank 默认使用下面的官方指令；可通过 RERANK_INSTRUCT 覆盖并记录到评测元信息。
# RERANK_INSTRUCT='Given a web search query, retrieve relevant passages that answer the query.'
